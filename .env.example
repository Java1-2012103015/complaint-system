# ── 데이터베이스 ──────────────────────────────
DATABASE_URL="postgresql://complaint_user:complaint_pass@localhost:5432/complaint_db"

# ── 공개 접속 URL (배정 알림 문자·메일 본문 {{siteUrlPhrase}} 등) ──
# 운영 도메인. 미설정 시 NEXTAUTH_URL이 사용됩니다.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── NextAuth ──────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_SECRET_32CHARS"
# 세션 유지(초). 생략 시 30일. 예: 86400=24시간, 3600=1시간
# NEXTAUTH_SESSION_MAX_AGE="86400"

# ── Aligo SMS ─────────────────────────────────
ALIGO_API_KEY="your_aligo_api_key"
ALIGO_USER_ID="your_aligo_user_id"
ALIGO_SENDER="0200000000"

# ── 이메일 (Nodemailer) ───────────────────────
SMTP_HOST="localhost"
SMTP_PORT="25"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@complaint.local"

# ── 파일 업로드 ───────────────────────────────
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="20"
